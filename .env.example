# 로컬 개발용 예시. 실제 값은 .env 에 두고 커밋하지 않는다.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taeil
# 통합 테스트용 DB (없으면 DB 테스트는 건너뜀)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/taeil_test
# TOTP 비밀키를 DB에 암호화해 저장할 때 쓰는 키 (32바이트, base64). 생성: openssl rand -base64 32
APP_ENCRYPTION_KEY=
