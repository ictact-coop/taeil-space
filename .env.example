# 로컬 개발용 예시. 실제 값은 .env 에 두고 커밋하지 않는다.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taeil
# 통합 테스트용 DB (없으면 DB 테스트는 건너뜀)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/taeil_test
# TOTP 비밀키를 DB에 암호화해 저장할 때 쓰는 키 (32바이트, base64). 생성: openssl rand -base64 32
APP_ENCRYPTION_KEY=
# 첨부파일·공간 사진 저장 위치 (기본: ./.data/uploads). 운영에서는 S3 호환 저장소 드라이버를 추가해 쓴다.
STORAGE_DIR=
# 악성코드 검사(clamd). 비우면 "검사 안 됨"으로 기록한다.
CLAMAV_HOST=
CLAMAV_PORT=3310
# 이용자 화면 주소 (알림 메일의 링크에 사용)
APP_BASE_URL=http://localhost:3000
# PortOne V2 (계약 후 PortOne 관리자 콘솔에서 발급). API 시크릿이 없으면 개발 환경에서는 가짜 결제를 쓴다.
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
# 운영 모드에서 가짜 결제를 켜려면 1 (시연용, 실제 운영에서는 비워 둘 것)
PAYMENT_FAKE=
# 이메일: log(기본, 서버 로그에만) | smtp
EMAIL_PROVIDER=log
EMAIL_FROM=
SMTP_URL=
