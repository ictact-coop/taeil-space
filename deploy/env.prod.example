# 운영 환경변수. 서버에서 deploy/.env 로 복사해 채운다 (권한 600, 커밋 금지).
# setup-server.sh가 이 파일을 복사하고 APP_ENCRYPTION_KEY·LOCAL_DB_PASSWORD를 자동으로 만든다.

# ── 사이트 ──
SITE_DOMAIN=rent.taeil.org
ACME_EMAIL=admin@taeil.org
APP_BASE_URL=https://rent.taeil.org
# 앞단 프록시 단계 수: Caddy만 있으면 1, 클라우드 로드밸런서 뒤에 Caddy를 두면 2
TRUST_PROXY_HOPS=1

# ── 함께 띄울 구성 ── localdb: 같은 VM의 PostgreSQL(권장 시작안), clamav: 첨부 악성코드 검사(메모리 +1.5GB)
COMPOSE_PROFILES=localdb

# ── DB ── 같은 VM(localdb): @db:5432 그대로 두고 비밀번호만 LOCAL_DB_PASSWORD와 같게.
#          관리형 PostgreSQL 16: 그 주소로 바꾸고(btree_gist 확장 필요) COMPOSE_PROFILES에서 localdb를 뺀다.
DATABASE_URL=postgres://taeil:CHANGE_ME@db:5432/taeil
LOCAL_DB_PASSWORD=CHANGE_ME

# ── 암호화 키 ── openssl rand -base64 32  (분실 시 관리자 2단계 인증을 모두 다시 등록해야 함. 서버 밖에 따로 보관)
APP_ENCRYPTION_KEY=

# ── 메일 ── (AWS SES 예: SMTP_HOST=email-smtp.ap-northeast-2.amazonaws.com, SES에서 만든 SMTP 사용자명·비밀번호)
EMAIL_PROVIDER=smtp
EMAIL_FROM="전태일기념관 대관 <rent@taeil.org>"
SMTP_HOST=email-smtp.ap-northeast-2.amazonaws.com
SMTP_PORT=465
SMTP_USER=
# 비밀번호는 따옴표 없이 그대로 (+ / 등이 있어도 인코딩하지 않는다)
SMTP_PASS=
# 대신 URL 한 줄로 쓸 수도 있다(이 값이 있으면 위 SMTP_*보다 우선, 특수문자는 URL 인코딩 필요)
SMTP_URL=

# ── 결제 ── 지금은 계좌이체로 운영하므로 비워 둔다. PG를 붙일 때 PortOne 라이브 키 4개를 넣는다(오픈 체크리스트 D절).
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
PORTONE_MODE=
# 운영에서는 반드시 비워 둔다
PAYMENT_FAKE=

# ── 악성코드 검사 (COMPOSE_PROFILES에 clamav를 넣었을 때 CLAMAV_HOST=clamav) ──
CLAMAV_HOST=
CLAMAV_PORT=3310

# ── 백업 서버 밖 보관 (권장) ── AWS S3: s3://버킷/daily/ , 엔드포인트는 비움
#    S3 호환 저장소(NCP Object Storage 등)는 BACKUP_S3_ENDPOINT=https://kr.object.ncloudstorage.com 처럼 주소를 넣는다
BACKUP_S3_URI=
BACKUP_S3_REGION=ap-northeast-2
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# ── 이미지 ── 외부 이미지는 AWS 공개 저장소(ECR Public)를 쓴다(Docker Hub 다운로드 제한 없음)
# 앱 이미지: GitHub Actions가 main 병합 때 빌드해 올린 이미지를 받는다(서버에서 빌드하지 않음).
# 비우면 서버에서 빌드한다(2GB 서버에서는 수십 분 걸릴 수 있음).
REGISTRY_IMAGE=ghcr.io/ictact-coop/taeil-space
POSTGRES_IMAGE=public.ecr.aws/docker/library/postgres:16
CADDY_IMAGE=public.ecr.aws/docker/library/caddy:2
