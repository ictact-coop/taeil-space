# 운영 환경변수 예시. 서버에서 deploy/.env 로 복사해 채운다 (권한 600, 커밋 금지).
# ── 사이트 ──
SITE_DOMAIN=rent.taeil.org
ACME_EMAIL=admin@taeil.org
APP_BASE_URL=https://rent.taeil.org
# 앞단 프록시 단계 수: Caddy만 있으면 1, 클라우드 로드밸런서 뒤에 Caddy를 두면 2
TRUST_PROXY_HOPS=1

# ── DB ── 관리형 PostgreSQL 16 (btree_gist 확장 필요). 같은 VM에 둘 때는 @db:5432 사용
DATABASE_URL=postgres://taeil:CHANGE_ME@db-host:5432/taeil?sslmode=require
LOCAL_DB_PASSWORD=

# ── 암호화 키 ── openssl rand -base64 32  (분실 시 관리자 2단계 인증을 다시 등록해야 함. 따로 보관)
APP_ENCRYPTION_KEY=

# ── 결제 (PortOne V2 라이브 키) ──
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=
# 관리자 연동 상태 화면에 '라이브'로 표시 (라이브 키를 넣었을 때 live)
PORTONE_MODE=live
PAYMENT_FAKE=

# ── 메일 ──
EMAIL_PROVIDER=smtp
EMAIL_FROM="전태일기념관 대관 <rent@taeil.org>"
SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465

# ── 악성코드 검사 (--profile clamav 사용 시) ──
CLAMAV_HOST=
CLAMAV_PORT=3310

# ── 백업 서버 밖 보관 (선택, S3 호환) ── 예: NCP Object Storage
BACKUP_S3_URI=
BACKUP_S3_ENDPOINT=https://kr.object.ncloudstorage.com
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
